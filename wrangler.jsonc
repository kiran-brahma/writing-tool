{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "writing-tool",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-19",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
